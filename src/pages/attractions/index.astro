---
import AppLayout from '../../layouts/AppLayout.astro';
import InfoDirectory from '../../islands/InfoDirectory.svelte';
import { buildInfoPageData } from '../../lib/infoPage';

const { cards, places, mapConfig, leafletBase, showMap } = await buildInfoPageData('attractions');
---

<AppLayout title="Достопримечательности" description="Места и магазины в Пекине и Шанхае">
  <header class="page-header">
    <h1>Достопримечательности и магазины</h1>
  </header>
  <InfoDirectory
    client:load
    {cards}
    {places}
    {mapConfig}
    {leafletBase}
    {showMap}
  />
</AppLayout>
