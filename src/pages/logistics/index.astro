---
import AppLayout from '../../layouts/AppLayout.astro';
import InfoDirectory from '../../islands/InfoDirectory.svelte';
import { buildLogisticsPageData } from '../../lib/infoPage';

const { cards, places, mapConfig, leafletBase, showMap } = await buildLogisticsPageData();
---

<AppLayout title="Логистика">
  <header class="page-header">
    <h1>Логистика</h1>
    <p>
      Файлы по типу транспорта: <code>flights.md</code>, <code>trains.md</code>, <code>buses.md</code> и др. В
      каждом — несколько маршрутов с заметками и ссылками на бронирование.
    </p>
  </header>
  <InfoDirectory client:load {cards} {places} {mapConfig} {leafletBase} {showMap} />
</AppLayout>
