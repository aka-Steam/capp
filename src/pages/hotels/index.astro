---
import AppLayout from '../../layouts/AppLayout.astro';
import HotelsDirectory from '../../islands/HotelsDirectory.svelte';
import { buildHotelsPageData } from '../../lib/infoPage';

const { cards, places, mapConfig, leafletBase, showMap } = await buildHotelsPageData();
---

<AppLayout title="Отели">
  <header class="page-header">
    <h1>Отели</h1>
    <p>
      Сравнение вариантов по городам. Укажите число ночей — цены пересчитаются. Сортировка по
      средней, одноместному или двухместному номеру (↑ / ↓).
    </p>
  </header>
  <HotelsDirectory client:load {cards} {places} {mapConfig} {leafletBase} {showMap} />
</AppLayout>
